# Local development: copy to .env.local (git-ignored), paste your Groq API key, and restart the Vite server.
# On Vercel, set GROQ_API_KEY under Project Settings → Environment Variables instead, then redeploy.
# Never use a VITE_ prefix for this variable: that would publish it in the browser bundle.
# Get a key at https://console.groq.com/keys — Groq's free tier needs an email
# account and no credit card, so a valid key works immediately.
GROQ_API_KEY=your_groq_api_key

# Optional: override the text model (defaults to openai/gpt-oss-120b). Use this if
# your account does not have access to the default, or you prefer another model —
# see https://console.groq.com/docs/models. The server cleans stray quotes, spaces
# and a "Bearer " prefix out of the key, but not an unsupported model name.
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: override the image model (defaults to qwen/qwen3.8-27b). Groq's text
# models reject image input outright, so reading a photo of a written plan needs a
# multimodal model. Set it to an empty string to disable image input.
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Optional: cross-device sync. Paste your Neon connection string (Neon console → Connect).
# Planner data is encrypted in the browser before upload; the database only stores ciphertext.
DATABASE_URL=postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Optional: background Web Push reminders. Generate a key pair with:
#   npx web-push generate-vapid-keys
# Set all values on the server (Vercel or local .env.local). Keep the private key secret.
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:you@example.com
# CRON_SECRET=a-long-random-secret

# ---------------------------------------------------------------------------
# The packaged apps (Android, iOS, desktop) are a different origin from this
# server. Nothing cross-origin is trusted unless you name it here, comma
# separated, as bare origins — no paths, no wildcards. Set this only when you
# build the apps with PLANNER_API_ORIGIN (see docs/APPS.md §2).
# PLANNER_APP_ORIGINS=capacitor://localhost,https://localhost,app://planner
# ---------------------------------------------------------------------------

# The build-time variables below are NOT server settings and do not belong
# in this file. Set them on the command line (or as GitHub Actions repository
# variables) when building an app:
#
#   PLANNER_APP_URL     load this deployment in the shell (browser-like)
#   PLANNER_API_ORIGIN  bundled offline build that sends /api/* to this origin
#   PLANNER_LINK_ORIGIN where a link the app hands out should point — defaults
#                       to PLANNER_APP_URL, then PLANNER_API_ORIGIN
#
#   PLANNER_API_ORIGIN=https://your-app.example.com npm run native:sync
#   npm run desktop:dist
#
# ---------------------------------------------------------------------------
# The deployment serves two files so that a link (a guardian's invite QR code)
# opens the installed app instead of a browser tab. They are written by
# `npm run build` into dist/.well-known/ from these variables, so they belong on
# the host that deploys the site — and they are public by design:
#
#   ANDROID_SIGNING_CERT_SHA256  the release certificate fingerprint, or a
#                                comma-separated list (debug builds included)
#   IOS_TEAM_ID                  your Apple Developer team id
#
#   ANDROID_SIGNING_CERT_SHA256=AA:BB:… IOS_TEAM_ID=AB12CD34EF npm run build
#
# docs/APPS.md §3 has both files, what must match in them, and how to check a
# live deployment — `npm run check:deployment` reports on them last.
# ---------------------------------------------------------------------------
