# Local development: copy to .env.local (git-ignored), paste your xAI API key, and restart the Vite server.
# On Vercel, set XAI_API_KEY under Project Settings → Environment Variables instead, then redeploy.
# Never use a VITE_ prefix for this variable: that would publish it in the browser bundle.
# A valid key still needs credits: if the AI answers "your team doesn't have any credits or
# licenses yet", the key reached xAI fine — add credits (or use a key from a funded team) at
# https://console.x.ai instead of editing this value.
XAI_API_KEY=your_xai_api_key

# Optional: override the model (defaults to grok-4.7). Use this if your key does
# not have access to the default model — the server cleans stray quotes, spaces
# and a "Bearer " prefix out of the key, but not an unsupported model name.
# XAI_MODEL=grok-4.7

# Optional: cross-device sync. Paste your Neon connection string (Neon console → Connect).
# Planner data is encrypted in the browser before upload; the database only stores ciphertext.
DATABASE_URL=postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require
