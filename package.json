{
  "name": "personal-planner",
  "private": true,
  "version": "1.1.6",
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build && node scripts/deep-link-files.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "test:e2e": "playwright test",
    "native:sync": "node scripts/native-sync.mjs",
    "android:open": "cap open android",
    "ios:open": "cap open ios",
    "desktop:dev": "node scripts/desktop-build.mjs --run",
    "desktop:pack": "node scripts/desktop-build.mjs --dir",
    "desktop:dist": "node scripts/desktop-build.mjs",
    "check:deployment": "node scripts/check-deployment.mjs",
    "lint:workflows": "node scripts/lint-workflows.mjs",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "check:release-tag": "node scripts/check-release-tag.mjs",
    "check:downloads": "node scripts/check-downloads.mjs",
    "size:report": "node scripts/report-sizes.mjs",
    "check:visual-baselines": "node scripts/check-visual-baselines.mjs",
    "check:bundle-budget": "node scripts/bundle-budget.mjs",
    "android:keystore": "node scripts/android-keystore.mjs",
    "test:e2e:visual": "playwright test e2e/visual.spec.ts",
    "test:e2e:visual:update": "playwright test e2e/visual.spec.ts --update-snapshots",
    "check:reports": "node scripts/check-reports.mjs"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/estedad": "^5.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "@noble/hashes": "^1.8.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/connect": "^3.4.38",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.4.1",
    "actionlint": "^2.0.6",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "js-yaml": "^4.3.2",
    "jsdom": "^30.1.3",
    "qrcode-generator": "^2.0.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild": true
  }
}
